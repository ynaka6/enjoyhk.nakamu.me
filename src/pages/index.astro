---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CategoryCard from '../components/CategoryCard.astro';
import PostCard from '../components/PostCard.astro';
import { categories, getPostSlug, resolveHeroImage, formatDate } from '../lib/data';

const allPosts = await getCollection('posts');
const posts = allPosts
  .filter((p) => p.data.status === 'published')
  .sort((a, b) => new Date(b.data.created_at).getTime() - new Date(a.data.created_at).getTime());

const heroPost = posts[0];
const heroSlug = heroPost ? getPostSlug(heroPost.id) : '';
const heroImage = heroPost ? resolveHeroImage(heroPost.data.hero, heroPost.id) : null;
const gridPosts = posts.slice(1, 13);
---

<BaseLayout>
  <!-- Hero Section -->
  {heroPost && (
    <section class="hero">
      <a href={`/post/${heroSlug}/`} class="hero-link">
        <div class="hero-image">
          {heroImage ? (
            <img src={heroImage} alt={heroPost.data.title} />
          ) : (
            <div class="hero-placeholder"></div>
          )}
          <div class="hero-overlay"></div>
        </div>
        <div class="hero-content">
          <span class="hero-category">{heroPost.data.category}</span>
          <h1 class="hero-title">{heroPost.data.title}</h1>
          <p class="hero-desc">{heroPost.data.description}</p>
          <time class="hero-date">{formatDate(heroPost.data.created_at)}</time>
        </div>
      </a>
    </section>
  )}

  <!-- Category Navigation -->
  <section class="categories">
    <div class="categories-grid">
      {categories.map((cat) => (
        <CategoryCard name={cat.name} slug={cat.slug} />
      ))}
    </div>
  </section>

  <!-- Latest Articles Grid -->
  <section class="latest">
    <h2 class="section-title">
      <span class="section-title-text">Latest</span>
      <span class="section-title-line"></span>
    </h2>
    <div class="posts-grid">
      {gridPosts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          category={post.data.category}
          tags={post.data.tags}
          created_at={post.data.created_at}
          hero={post.data.hero}
          slug={getPostSlug(post.id)}
          status={post.data.status}
        />
      ))}
    </div>
    <div class="more-link">
      <a href="/posts" class="more-button">
        すべての記事を見る
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  @reference "../styles/global.css";

  /* Hero */
  .hero {
    @apply mb-10;
  }
  .hero-link {
    @apply block relative rounded-xl overflow-hidden no-underline;
  }
  .hero-image {
    @apply w-full;
    aspect-ratio: 21 / 9;
  }
  .hero-image img {
    @apply w-full h-full object-cover;
  }
  .hero-placeholder {
    @apply w-full h-full;
    background: linear-gradient(135deg, var(--theme-surface) 0%, var(--theme-card) 100%);
  }
  .hero-overlay {
    @apply absolute inset-0;
    background: linear-gradient(to top, var(--theme-overlay-from) 0%, var(--theme-overlay-to) 60%);
  }
  .hero-content {
    @apply absolute bottom-0 left-0 right-0 p-6;
  }
  .hero-category {
    @apply inline-block px-3 py-1 text-xs font-bold text-white rounded-full mb-3;
    background: var(--color-primary);
    box-shadow: 0 0 12px var(--theme-glow-primary);
  }
  .hero-title {
    @apply text-xl font-bold text-white mb-2 leading-tight;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }
  .hero-desc {
    @apply text-sm text-gray-300 mb-2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .hero-date {
    @apply text-xs text-gray-400;
  }
  .hero-link:hover .hero-overlay {
    background: linear-gradient(to top, rgba(255, 70, 70, 0.3) 0%, var(--theme-overlay-to) 60%);
  }

  /* Categories */
  .categories {
    @apply mb-10;
  }
  .categories-grid {
    @apply grid grid-cols-2 gap-3;
  }

  /* Section Title */
  .section-title {
    @apply flex items-center gap-4 mb-6;
  }
  .section-title-text {
    @apply text-lg font-bold tracking-widest uppercase;
    color: var(--theme-text-heading);
    text-shadow: var(--theme-neon-text);
  }
  .section-title-line {
    @apply flex-1 h-px;
    background: linear-gradient(to right, var(--color-primary), transparent);
    box-shadow: 0 0 5px var(--theme-glow-primary-line);
  }

  /* Posts Grid */
  .posts-grid {
    @apply grid grid-cols-1 gap-4;
  }

  /* More Link */
  .more-link {
    @apply text-center mt-8;
  }
  .more-button {
    @apply inline-block px-8 py-3 text-sm font-bold no-underline rounded-full transition-all duration-300;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    box-shadow: 0 0 10px var(--theme-glow-primary-soft);
  }
  .more-button:hover {
    @apply text-white;
    background: var(--color-primary);
    box-shadow: 0 0 20px var(--theme-glow-primary);
  }

  @media (min-width: 768px) {
    .hero-title {
      @apply text-3xl;
    }
    .hero-content {
      @apply p-10;
    }
    .categories-grid {
      @apply grid-cols-4;
    }
    .posts-grid {
      @apply grid-cols-2;
    }
  }
  @media (min-width: 1024px) {
    .posts-grid {
      @apply grid-cols-3;
    }
    .hero-title {
      @apply text-4xl;
    }
  }
</style>
