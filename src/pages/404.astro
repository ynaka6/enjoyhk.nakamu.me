---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません">
  <div class="text-center py-20">
    <svg class="w-20 h-20 mx-auto text-gray-400 fill-current mb-6" version="1.1" viewBox="0 0 36 36" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
      <path d="M18,2A16,16,0,1,0,34,18,16,16,0,0,0,18,2Zm0,30A14,14,0,1,1,32,18,14,14,0,0,1,18,32Z" />
      <circle cx="25.16" cy="14.28" r="1.8" />
      <circle cx="11.41" cy="14.28" r="1.8" />
      <path d="M18.16,20a9,9,0,0,0-7.33,3.78,1,1,0,1,0,1.63,1.16,7,7,0,0,1,11.31-.13,1,1,0,0,0,1.6-1.2A9,9,0,0,0,18.16,20Z" />
    </svg>
    <h1 class="text-3xl font-bold text-gray-700 mb-4">404</h1>
    <p class="text-gray-600 mb-8">お探しのページが見つかりませんでした。</p>
    <a href="/" class="px-6 py-3 border rounded-sm font-bold text-sm no-underline text-gray-700 hover:bg-gray-100">
      トップページへ戻る
    </a>
  </div>
</BaseLayout>
