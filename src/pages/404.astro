---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ページが見つかりません">
  <div class="text-center py-20">
    <div class="neon-404">404</div>
    <p class="desc">お探しのページが見つかりませんでした。</p>
    <a href="/" class="home-link">
      トップページへ戻る
    </a>
  </div>
</BaseLayout>

<style>
  @reference "../styles/global.css";
  .neon-404 {
    @apply text-8xl font-bold mb-6;
    color: var(--color-primary);
    text-shadow: 0 0 20px var(--color-primary), 0 0 40px var(--color-primary), 0 0 80px var(--color-neon-pink);
  }
  .desc {
    @apply mb-8 text-lg;
    color: var(--theme-text-muted);
  }
  .home-link {
    @apply inline-block px-8 py-3 text-sm font-bold no-underline rounded-full transition-all duration-300;
    color: var(--theme-link);
    border: 1px solid var(--theme-link);
  }
  .home-link:hover {
    @apply text-white;
    background: var(--theme-link);
    box-shadow: 0 0 20px var(--theme-glow-primary);
  }
</style>
