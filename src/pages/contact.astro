---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<BaseLayout title="お問い合わせ">
  <Breadcrumb items={[{ label: 'お問い合わせ' }]} />

  <h1 class="page-title">お問い合わせ</h1>

  <form name="contact" method="POST" data-netlify="true" class="max-w-2xl mx-auto px-4">
    <input type="hidden" name="form-name" value="contact" />
    <div class="mb-6">
      <label for="name" class="block text-sm font-bold text-gray-700 mb-2">お名前</label>
      <input
        type="text"
        id="name"
        name="name"
        required
        class="w-full px-3 py-2 border border-gray-300 rounded-sm focus:outline-none focus:border-primary"
      />
    </div>
    <div class="mb-6">
      <label for="email" class="block text-sm font-bold text-gray-700 mb-2">メールアドレス</label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full px-3 py-2 border border-gray-300 rounded-sm focus:outline-none focus:border-primary"
      />
    </div>
    <div class="mb-6">
      <label for="content" class="block text-sm font-bold text-gray-700 mb-2">お問い合わせ内容</label>
      <textarea
        id="content"
        name="content"
        rows="8"
        required
        class="w-full px-3 py-2 border border-gray-300 rounded-sm focus:outline-none focus:border-primary"
      ></textarea>
    </div>
    <div class="text-center">
      <button type="submit" class="px-8 py-3 bg-primary text-white font-bold rounded-sm hover:opacity-75">
        送信する
      </button>
    </div>
  </form>
</BaseLayout>

<style>
  @reference "tailwindcss";
  .page-title {
    @apply text-center w-full font-bold mb-10 text-3xl relative inline-block px-5;
  }
</style>
