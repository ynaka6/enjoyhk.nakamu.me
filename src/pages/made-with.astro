---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<BaseLayout title="このサイトについて">
  <Breadcrumb items={[{ label: 'このサイトについて' }]} />

  <h1 class="page-title">このサイトについて</h1>

  <div class="space-y-8">
    <section class="tech-card">
      <div class="flex items-center mb-4">
        <img src="/images/astro-icon.svg" alt="Astro" class="w-12 h-12 mr-4 rounded-lg" />
        <h2 class="card-heading">Astro</h2>
      </div>
      <p class="card-text">
        このサイトは<a href="https://astro.build/" target="_blank" rel="nofollow noopener noreferrer">Astro</a>を使って構築されています。
        Astroは高速な静的サイトジェネレーターで、ゼロJavaScriptをデフォルトで出力し、優れたパフォーマンスを実現します。
      </p>
    </section>

    <section class="tech-card">
      <div class="flex items-center mb-4">
        <img src="/images/tailwind-icon.png" alt="TailwindCSS" class="w-12 h-12 mr-4 rounded-lg" />
        <h2 class="card-heading">Tailwind CSS</h2>
      </div>
      <p class="card-text">
        スタイリングには<a href="https://tailwindcss.com/" target="_blank" rel="nofollow noopener noreferrer">Tailwind CSS</a>を使用しています。
        ユーティリティファーストのCSSフレームワークで、効率的にデザインを構築できます。
      </p>
    </section>

    <section class="tech-card">
      <div class="flex items-center mb-4">
        <img src="/images/netlify-icon.png" alt="Netlify" class="w-12 h-12 mr-4 rounded-lg" />
        <h2 class="card-heading">Netlify</h2>
      </div>
      <p class="card-text">
        ホスティングには<a href="https://www.netlify.com/" target="_blank" rel="nofollow noopener noreferrer">Netlify</a>を使用しています。
        GitHubと連携して自動デプロイを実現しています。
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  @reference "../styles/global.css";
  .page-title {
    @apply text-center w-full font-bold mb-10 text-3xl;
    color: var(--theme-text-heading);
  }
  .tech-card {
    @apply p-6 rounded-xl;
    background: var(--theme-card);
    border: 1px solid var(--theme-border);
  }
  .card-heading {
    @apply text-2xl font-bold;
    color: var(--theme-text-heading);
  }
  .card-text {
    color: var(--theme-text-muted);
  }
</style>
