---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<BaseLayout title="このサイトについて">
  <Breadcrumb items={[{ label: 'このサイトについて' }]} />

  <h1 class="text-center w-full font-bold mb-10 text-3xl">このサイトについて</h1>

  <div class="px-4">
    <section class="mb-12">
      <div class="flex items-center mb-4">
        <img src="/images/gatsby-icon.png" alt="Astro" class="w-12 h-12 mr-4" />
        <h2 class="text-2xl font-bold">Astro</h2>
      </div>
      <p class="text-gray-700 mb-4">
        このサイトは<a href="https://astro.build/" target="_blank" rel="nofollow noopener noreferrer">Astro</a>を使って構築されています。
        Astroは高速な静的サイトジェネレーターで、ゼロJavaScriptをデフォルトで出力し、優れたパフォーマンスを実現します。
      </p>
    </section>

    <section class="mb-12">
      <div class="flex items-center mb-4">
        <img src="/images/tailwind-icon.png" alt="TailwindCSS" class="w-12 h-12 mr-4" />
        <h2 class="text-2xl font-bold">Tailwind CSS</h2>
      </div>
      <p class="text-gray-700 mb-4">
        スタイリングには<a href="https://tailwindcss.com/" target="_blank" rel="nofollow noopener noreferrer">Tailwind CSS</a>を使用しています。
        ユーティリティファーストのCSSフレームワークで、効率的にデザインを構築できます。
      </p>
    </section>

    <section class="mb-12">
      <div class="flex items-center mb-4">
        <img src="/images/netlify-icon.png" alt="Netlify" class="w-12 h-12 mr-4" />
        <h2 class="text-2xl font-bold">Netlify</h2>
      </div>
      <p class="text-gray-700 mb-4">
        ホスティングには<a href="https://www.netlify.com/" target="_blank" rel="nofollow noopener noreferrer">Netlify</a>を使用しています。
        GitHubと連携して自動デプロイを実現しています。
      </p>
    </section>
  </div>
</BaseLayout>
