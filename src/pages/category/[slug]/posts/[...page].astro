---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostCard from '../../../../components/PostCard.astro';
import Pagination from '../../../../components/Pagination.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import { categories, getCategorySlug, getPostSlug } from '../../../../lib/data';

export const getStaticPaths = (async ({ paginate }) => {
  const allPosts = await getCollection('posts');
  const publishedPosts = allPosts
    .filter((p) => p.data.status === 'published')
    .sort((a, b) => new Date(b.data.created_at).getTime() - new Date(a.data.created_at).getTime());

  return categories.flatMap((category) => {
    const filtered = publishedPosts.filter((p) => p.data.category === category.name);
    return paginate(filtered, {
      params: { slug: category.slug },
      pageSize: 20,
    });
  });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const { slug } = Astro.params;
const category = categories.find((c) => c.slug === slug);
const categoryName = category?.name || slug;
---

<BaseLayout title={`${categoryName}の記事一覧`}>
  <Breadcrumb items={[
    { label: '記事一覧', href: '/posts' },
    { label: categoryName },
  ]} />

  <h1 class="text-center w-full font-bold mb-10 text-3xl relative inline-block px-5">
    {categoryName}
  </h1>

  {page.data.map((post) => (
    <PostCard
      title={post.data.title}
      description={post.data.description}
      category={post.data.category}
      tags={post.data.tags}
      created_at={post.data.created_at}
      hero={post.data.hero}
      slug={getPostSlug(post.id)}
      status={post.data.status}
    />
  ))}

  <Pagination
    currentPage={page.currentPage}
    totalPages={page.lastPage}
    basePath={`/category/${slug}/posts`}
  />
</BaseLayout>
