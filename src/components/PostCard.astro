---
import { getCategorySlug, getTagSlug, formatDate, resolveHeroImage } from '../lib/data';

interface Props {
  title: string;
  description: string;
  category: string;
  tags: string[];
  created_at: string;
  hero?: string;
  slug: string;
  status?: string;
}

const { title, description, category, tags, created_at, hero, slug, status } = Astro.props;
const categorySlug = getCategorySlug(category);
const heroSrc = resolveHeroImage(hero, slug);
---

<a href={`/post/${slug}/`} class="card block no-underline">
  <div class="category-row">
    <span class="category-button">{category}</span>
    {status === 'writting' && <span class="status-tag">下書き</span>}
  </div>
  <div class="content">
    <div class="content-title">
      <h2 class="text-lg font-bold text-gray-900 mb-2">{title}</h2>
      <p class="text-sm text-gray-600 mb-2">{description}</p>
      <div class="flex flex-wrap mb-2">
        {tags.map((tag) => (
          <span class="tag-button">{tag}</span>
        ))}
      </div>
      <time class="text-sm text-gray-600" datetime={created_at}>{formatDate(created_at)}</time>
    </div>
    {heroSrc && (
      <div class="content-image">
        <img src={heroSrc} alt={title} class="w-full h-auto object-cover rounded-sm" loading="lazy" />
      </div>
    )}
  </div>
</a>

<style>
  @reference "tailwindcss";
  .card {
    @apply bg-white mb-2 px-4 py-4;
    background-image: linear-gradient(to top, var(--color-gray-100), var(--color-white));
    transition: transform 0.2s;
  }
  .card:hover {
    transform: translateY(-0.25rem);
    @apply shadow;
  }
  .category-row {
    @apply w-full flex justify-center items-center gap-2 mb-4;
  }
  .category-button {
    @apply font-bold text-gray-600 border rounded-full px-4 py-1 text-sm;
  }
  .status-tag {
    @apply px-3 py-1 border border-yellow-400 bg-yellow-100 rounded-lg font-bold text-yellow-600 text-xs whitespace-nowrap;
  }
  .content {
    @apply flex flex-col-reverse;
  }
  .content-image {
    @apply mb-2;
  }
  .tag-button {
    @apply bg-red-100 px-4 py-1 mb-1 mr-1 border border-red-400 rounded-full font-bold text-red-700 text-xs whitespace-nowrap;
  }
  @media (min-width: 1024px) {
    .content {
      @apply flex-row;
    }
    .content-title {
      @apply w-2/3 pr-2;
    }
    .content-image {
      @apply w-1/3;
    }
  }
</style>
