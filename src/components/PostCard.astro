---
import { getCategorySlug, getTagSlug, formatDate, resolveHeroImage } from '../lib/data';

interface Props {
  title: string;
  description: string;
  category: string;
  tags: string[];
  created_at: string;
  hero?: string;
  slug: string;
  status?: string;
}

const { title, description, category, tags, created_at, hero, slug, status } = Astro.props;
const categorySlug = getCategorySlug(category);
const heroSrc = resolveHeroImage(hero, slug);
---

<a href={`/post/${slug}/`} class="card block">
  <div class="card-image">
    {heroSrc ? (
      <img src={heroSrc} alt={title} loading="lazy" />
    ) : (
      <div class="placeholder"></div>
    )}
    <span class="category-badge">{category}</span>
    {status === 'writting' && <span class="draft-badge">下書き</span>}
  </div>
  <div class="card-body">
    <h2 class="card-title">{title}</h2>
    <p class="card-desc">{description}</p>
    <div class="card-meta">
      <time datetime={created_at}>{formatDate(created_at)}</time>
      <div class="card-tags">
        {tags.slice(0, 3).map((tag) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    </div>
  </div>
</a>

<style>
  @reference "../styles/global.css";
  .card {
    @apply bg-dark-card rounded-lg overflow-hidden no-underline transition-all duration-300;
    border: 1px solid rgba(255, 255, 255, 0.06);
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 70, 70, 0.4);
    box-shadow: 0 8px 30px rgba(255, 70, 70, 0.15), 0 0 15px rgba(255, 70, 70, 0.1);
  }
  .card-image {
    @apply relative w-full overflow-hidden;
    aspect-ratio: 16 / 9;
  }
  .card-image img {
    @apply w-full h-full object-cover transition-transform duration-500;
  }
  .card:hover .card-image img {
    transform: scale(1.05);
  }
  .placeholder {
    @apply w-full h-full;
    background: linear-gradient(135deg, var(--color-dark-surface) 0%, var(--color-dark-card) 100%);
  }
  .category-badge {
    @apply absolute top-3 left-3 px-3 py-1 text-xs font-bold text-white rounded-full;
    background: rgba(255, 70, 70, 0.85);
    backdrop-filter: blur(4px);
  }
  .draft-badge {
    @apply absolute top-3 right-3 px-3 py-1 text-xs font-bold text-yellow-300 rounded-full;
    background: rgba(255, 225, 86, 0.2);
    border: 1px solid rgba(255, 225, 86, 0.5);
  }
  .card-body {
    @apply p-4;
  }
  .card-title {
    @apply text-base font-bold text-white mb-2 leading-snug;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-desc {
    @apply text-sm text-gray-400 mb-3 leading-relaxed;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card-meta {
    @apply flex items-center justify-between text-xs text-gray-500;
  }
  .card-tags {
    @apply flex gap-1;
  }
  .tag {
    @apply px-2 py-0.5 rounded-full text-xs;
    background: rgba(0, 240, 255, 0.1);
    color: var(--color-neon-cyan);
    border: 1px solid rgba(0, 240, 255, 0.2);
  }
</style>
