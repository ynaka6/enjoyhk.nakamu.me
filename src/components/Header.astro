---
import { siteMetadata, categories } from '../lib/data';
---

<header class="header">
  <div class="header-container">
    <a href="/" class="logo">
      <span class="logo-text">Enjoy</span><span class="logo-hk">HK</span>
    </a>
    <nav class="nav-links">
      {categories.map((cat) => (
        <a href={`/category/${cat.slug}/posts`} class="nav-link">{cat.name}</a>
      ))}
    </nav>
    <button class="menu-toggle" aria-label="メニュー" id="menuToggle">
      <span class="menu-bar"></span>
      <span class="menu-bar"></span>
      <span class="menu-bar"></span>
    </button>
  </div>
  <nav class="mobile-nav" id="mobileNav">
    {categories.map((cat) => (
      <a href={`/category/${cat.slug}/posts`} class="mobile-nav-link">{cat.name}</a>
    ))}
    <a href="/contact" class="mobile-nav-link">お問い合わせ</a>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menuToggle');
  const nav = document.getElementById('mobileNav');
  toggle?.addEventListener('click', () => {
    nav?.classList.toggle('open');
    toggle.classList.toggle('open');
  });
</script>

<style>
  @reference "../styles/global.css";
  .header {
    @apply fixed w-full z-50 top-0 border-b border-gray-800;
    background: rgba(10, 10, 15, 0.92);
    backdrop-filter: blur(12px);
  }
  .header-container {
    @apply max-w-5xl mx-auto flex items-center justify-between px-4 py-3;
  }
  .logo {
    @apply flex items-baseline gap-0.5 no-underline;
  }
  .logo-text {
    @apply text-2xl font-bold text-white;
  }
  .logo-hk {
    @apply text-2xl font-bold text-primary;
    text-shadow: 0 0 10px var(--color-primary), 0 0 30px rgba(255, 70, 70, 0.5);
  }
  .nav-links {
    @apply hidden items-center gap-6;
  }
  .nav-link {
    @apply text-sm font-medium text-gray-300 no-underline transition-colors;
  }
  .nav-link:hover {
    @apply text-primary;
    text-shadow: 0 0 8px rgba(255, 70, 70, 0.5);
  }
  .menu-toggle {
    @apply flex flex-col gap-1.5 bg-transparent border-none cursor-pointer p-1;
  }
  .menu-bar {
    @apply block w-6 h-0.5 bg-gray-300 transition-all duration-300;
  }
  .menu-toggle.open .menu-bar:nth-child(1) {
    transform: rotate(45deg) translate(4px, 4px);
  }
  .menu-toggle.open .menu-bar:nth-child(2) {
    @apply opacity-0;
  }
  .menu-toggle.open .menu-bar:nth-child(3) {
    transform: rotate(-45deg) translate(4px, -4px);
  }
  .mobile-nav {
    @apply hidden flex-col px-4 pb-4 gap-1 border-t border-gray-800;
    background: rgba(10, 10, 15, 0.95);
  }
  .mobile-nav.open {
    @apply flex;
  }
  .mobile-nav-link {
    @apply py-2 text-gray-300 no-underline text-sm font-medium border-b border-gray-800;
  }
  .mobile-nav-link:hover {
    @apply text-primary;
  }
  @media (min-width: 768px) {
    .nav-links {
      @apply flex;
    }
    .menu-toggle {
      @apply hidden;
    }
  }
</style>
