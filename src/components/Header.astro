---
import { siteMetadata } from '../lib/data';
---

<header class="header">
  <div class="header-container">
    <div class="header-box">
      <a href="/" class="logo text-3xl">
        {siteMetadata.title}<sup>HK</sup>
      </a>
    </div>
  </div>
</header>

<style>
  @reference "tailwindcss";
  .header {
    @apply fixed w-full z-10 top-0 bg-white border-b border-gray-400;
  }
  .header-container {
    @apply mx-auto;
  }
  .header-box {
    @apply flex justify-between items-center py-2 px-4;
  }
  @media (min-width: 640px) {
    .header-container { max-width: 640px; }
  }
  @media (min-width: 768px) {
    .header-container { max-width: 768px; }
  }
  @media (min-width: 1024px) {
    .header-container { max-width: 1024px; }
    .header-box { @apply px-5; }
  }
  @media (min-width: 1280px) {
    .header-container { max-width: 1280px; }
  }
</style>
