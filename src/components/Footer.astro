<footer class="footer">
  <div class="footer-container">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="brand-logo">
          <svg class="brand-icon" width="22" height="22" viewBox="0 0 64 64" aria-hidden="true">
            <g transform="translate(32,32)" fill="currentColor">
              <path d="M0,1 C-2,-3 -6,-8 -7,-13 C-7.5,-15.5 -6,-17 -4,-17.5 C-2.5,-18 -1,-17 0,-15 C0,-17 0.5,-19.5 2,-20 C3.5,-20.5 5.5,-19 5,-16 C4.5,-13 2,-7 0,1Z" transform="rotate(0)" opacity="0.85"/>
              <path d="M0,1 C-2,-3 -6,-8 -7,-13 C-7.5,-15.5 -6,-17 -4,-17.5 C-2.5,-18 -1,-17 0,-15 C0,-17 0.5,-19.5 2,-20 C3.5,-20.5 5.5,-19 5,-16 C4.5,-13 2,-7 0,1Z" transform="rotate(72)" opacity="0.85"/>
              <path d="M0,1 C-2,-3 -6,-8 -7,-13 C-7.5,-15.5 -6,-17 -4,-17.5 C-2.5,-18 -1,-17 0,-15 C0,-17 0.5,-19.5 2,-20 C3.5,-20.5 5.5,-19 5,-16 C4.5,-13 2,-7 0,1Z" transform="rotate(144)" opacity="0.85"/>
              <path d="M0,1 C-2,-3 -6,-8 -7,-13 C-7.5,-15.5 -6,-17 -4,-17.5 C-2.5,-18 -1,-17 0,-15 C0,-17 0.5,-19.5 2,-20 C3.5,-20.5 5.5,-19 5,-16 C4.5,-13 2,-7 0,1Z" transform="rotate(216)" opacity="0.85"/>
              <path d="M0,1 C-2,-3 -6,-8 -7,-13 C-7.5,-15.5 -6,-17 -4,-17.5 C-2.5,-18 -1,-17 0,-15 C0,-17 0.5,-19.5 2,-20 C3.5,-20.5 5.5,-19 5,-16 C4.5,-13 2,-7 0,1Z" transform="rotate(288)" opacity="0.85"/>
            </g>
            <circle cx="32" cy="32" r="2.5" fill="currentColor" opacity="0.6"/>
          </svg>
          <span class="brand-text">Enjoy</span><span class="brand-hk">HK</span>
        </div>
        <p class="brand-desc">香港の魅力を日本語で発信するメディア</p>
      </div>
      <div class="footer-links">
        <a href="/posts">記事一覧</a>
        <a href="/contact">お問い合わせ</a>
        <a href="/policy/privacy">プライバシーポリシー</a>
        <a href="/made-with">About</a>
      </div>
    </div>
    <div class="footer-divider"></div>
    <div class="footer-bottom">
      <p class="copyright">
        &copy; {new Date().getFullYear()} Enjoy HK. All rights reserved.
      </p>
      <div class="footer-external">
        <a href="https://overseas.blogmura.com/hongkong/ranking.html" target="_blank" rel="nofollow noopener noreferrer" class="none-external-link">
          <img src="https://b.blogmura.com/overseas/hongkong/88_31.gif" alt="にほんブログ村 海外生活ブログ 香港情報へ" width="88" height="31" />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  @reference "../styles/global.css";
  .footer {
    @apply mt-16;
    background: var(--theme-card);
    border-top: 1px solid var(--theme-border-strong);
    transition: background 0.3s, border-color 0.3s;
  }
  .footer-container {
    @apply max-w-5xl mx-auto px-4 py-10;
  }
  .footer-top {
    @apply flex flex-col gap-6;
  }
  .footer-brand {
    @apply flex flex-col gap-1;
  }
  .brand-logo {
    @apply flex items-center gap-1.5;
  }
  .brand-icon {
    color: var(--color-primary);
  }
  .brand-text {
    @apply text-xl tracking-tight;
    font-family: 'Georgia', 'Times New Roman', serif;
    font-weight: 700;
    font-style: italic;
    color: var(--theme-text-heading);
  }
  .brand-hk {
    @apply text-xl tracking-tight text-primary;
    font-family: 'Georgia', 'Times New Roman', serif;
    font-weight: 700;
    font-style: italic;
    text-shadow: var(--theme-neon-text);
  }
  .brand-desc {
    @apply text-sm mt-1;
    color: var(--theme-text-faint);
  }
  .footer-links {
    @apply flex flex-wrap gap-4;
  }
  .footer-links a {
    @apply text-sm no-underline;
    color: var(--theme-text-muted);
  }
  .footer-links a:hover {
    @apply text-primary;
  }
  .footer-divider {
    @apply my-6;
    border-top: 1px solid var(--theme-border-strong);
  }
  .footer-bottom {
    @apply flex flex-col gap-4 items-center;
  }
  .copyright {
    @apply text-xs;
    color: var(--theme-text-faint);
  }
  @media (min-width: 768px) {
    .footer-top {
      @apply flex-row justify-between items-start;
    }
    .footer-bottom {
      @apply flex-row justify-between;
    }
  }
</style>
