---
import { tags } from '../lib/data';
---

<div class="card">
  <h2 class="card-title">TAGS</h2>
  <div class="flex flex-wrap">
    {tags.map((tag) => (
      <a
        href={`/tag/${tag.slug}/posts`}
        class="tag-button"
      >
        {tag.name}
      </a>
    ))}
  </div>
</div>

<style>
  @reference "../styles/global.css";
  .card {
    @apply w-full bg-white border px-5 py-5 rounded-lg;
  }
  .card-title {
    @apply font-bold mb-3;
  }
  .tag-button {
    @apply bg-red-100 px-4 py-1 mb-1 mr-1 border border-red-400 rounded-full font-bold text-red-700 text-xs whitespace-nowrap;
  }
  .tag-button:hover {
    @apply opacity-75;
  }
</style>
